---
import Base from "../layouts/Base.astro";
import Clip from "../components/Clip.astro";
import Terminal from "../components/Terminal.astro";
import Pipeline from "../components/Pipeline.astro";
import Footer from "../components/Footer.astro";
import { person, battleroom, resume, numbers, skills, alertRules } from "../data/site";

const tools = [
  "AWS", "Terraform", "Ansible", "Docker", "GitHub Actions", "Prometheus", "Grafana", "Alertmanager",
  "Nginx", "Let’s Encrypt", "Linux", "Bash", "Node.js", "Socket.IO", "MongoDB", "Jenkins",
];

// stack.yml: the short version of the infrastructure, as config. Facts from CLAUDE.md.
type Y = { i?: number; k?: string; v?: string; n?: boolean; c?: string };
const stack: Y[] = [
  { c: "# battleroom/stack.yml · the short version" },
  { k: "aws" },
  { i: 1, k: "terraform", v: "23 resources", n: true, c: "# VPC, subnet, gateway, routes, 2 × EC2" },
  { i: 1, k: "app_server", v: "ec2 · 1 GB", c: "# nginx → node.js + socket.io" },
  { i: 1, k: "monitoring", v: "ec2 · t3.micro", c: "# its own box, so it outlives the app" },
  { i: 1, k: "metrics_ports", v: "[9100, 9101]", n: true, c: "# monitoring server only" },
  { i: 1, k: "imdsv2", v: "enforced" },
  { k: "ansible" },
  { i: 1, k: "roles", v: "[base, certbot]", c: "# blank server → running app" },
  { i: 1, k: "handlers", v: "restart only on change" },
  { k: "nginx" },
  { i: 1, k: "proxy", v: "websockets" },
  { i: 1, k: "tls", v: "lets-encrypt", c: "# renewals don't drop live games" },
  { k: "ci" },
  { i: 1, k: "runner", v: "github-actions" },
  { i: 1, k: "deploy_by", v: "commit-sha", c: "# never :latest" },
  { i: 1, k: "uptime_check", v: "every 15m", c: "# from outside AWS" },
];

// One string, so the <pre> doesn't pick up template whitespace.
const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const yamlHtml = stack
  .map((l) =>
    [
      "  ".repeat(l.i ?? 0),
      l.k ? `<span class="yk">${esc(l.k)}</span><span class="yp">:</span>` : "",
      l.v ? `<span class="${l.n ? "yn" : "yv"}"> ${esc(l.v)}</span>` : "",
      l.c ? `<span class="yc">${l.k ? "  " : ""}${esc(l.c)}</span>` : "",
    ].join(""),
  )
  .join("\n");

const jobBullets = [
  "Automated a repetitive bulk portal task across ~460 accounts by scripting the portal’s own API requests with data from read-only SQL.",
  "Wrote SQL against production databases to trace billing and payment discrepancies to root cause.",
  "Debugged REST API provisioning failures with Postman across subscriber, billing and SIM inventory modules.",
  "Standardized agent permission and role configs across operators against a baseline, reducing configuration drift.",
  "Ran bulk operations across 3,500+ agents on a live platform, working with Dev, QA, DevOps and client teams.",
];
---

<Base
  title="Utkarsh Tyagi · DevOps Engineer"
  description="Utkarsh Tyagi, DevOps Engineer in Noida, India, open to remote. BattleRoom: a live multiplayer game on AWS with Terraform, Ansible, a five-job GitHub Actions pipeline, Prometheus, Grafana and Alertmanager."
>
  <main id="main">
    <!-- HERO -->
    <section class="hero wrap" aria-labelledby="hero-name">
      <div class="hero-copy">
        <p class="hero-chip"><span class="dot" aria-hidden="true"></span> Open to DevOps &amp; cloud roles</p>
        <h1 id="hero-name">Utkarsh<br />Tyagi<span class="period">.</span></h1>
        <p class="tagline">
          DevOps engineer. I build the servers, ship code through pipelines, and get pinged the moment something breaks.
        </p>
        <p class="where">
          Noida, India · open to remote · overlaps US hours
          <span class="clock" data-clock aria-live="off">IST · UTC+5:30</span>
        </p>
        <ul class="hero-actions" role="list">
          <li><a class="btn btn-primary" href="/battleroom/">Read the case study <span aria-hidden="true">→</span></a></li>
          <li><a class="btn ext" href={battleroom.live} rel="noopener">Live app</a></li>
          <li><a class="btn ext" href={person.github} rel="noopener">GitHub</a></li>
          <li>
            {
              resume ? (
                <a class="btn" href={resume}>Resume <span class="mono dim">PDF</span></a>
              ) : (
                <span class="btn" aria-disabled="true">Resume · PDF pending</span>
              )
            }
          </li>
        </ul>
      </div>
      <Terminal />
    </section>

    <!-- TOOLS MARQUEE -->
    <div class="marquee" role="region" aria-label="Tools I work with">
      <div class="marquee-track">
        {
          [0, 1].map((copy) => (
            <ul class="marquee-list" role="list" aria-hidden={copy === 1 ? "true" : undefined}>
              {tools.map((t) => <li>{t}</li>)}
            </ul>
          ))
        }
      </div>
    </div>

    <!-- WATCH IT RUN -->
    <section class="section" id="proof" aria-labelledby="proof-title">
      <div class="wrap">
        <p class="eyebrow">Proof, not promises</p>
        <h2 id="proof-title" class="section-title">Watch it run.</h2>
        <p class="section-intro">
          BattleRoom is a real-time multiplayer quiz game I built and run on AWS. These are screen recordings of the real
          system, sped up. Hit <span class="kbd-inline" aria-hidden="true">⤢</span><span class="visually-hidden">expand</span>
          on any of them to watch full size.
        </p>

        <div class="bento">
          <Clip
            class="b-game"
            name="battleroom-game"
            chip="Live game"
            label="Two browsers playing one live BattleRoom game"
            caption="Two browsers, one room: questions land in both at once and scores update live."
            width={1440}
            height={716}
          />
          <Clip
            class="b-discord fill"
            name="discord-alert"
            chip="Alert"
            tone="warn"
            fit="contain"
            label="Discord #alerts channel: a TargetDown alert fires, then resolves"
            caption="My phone: TargetDown fires in #alerts, then resolves."
            width={540}
            height={1020}
          />
          <Clip
            class="b-pipe"
            name="pipeline-run"
            chip="git push → green"
            label="A GitHub Actions run: jobs turn green, Ansible deploys, smoke tests pass"
            caption="A real run: test, infra-lint and docker go green, Ansible deploys, /healthz reports ok with the new SHA."
            width={1280}
            height={800}
          />
          <Clip
            class="b-grafana"
            name="grafana-dashboard"
            chip="Grafana"
            label="Grafana dashboard: traffic, latency, live players, health checks and certificate expiry"
            caption="Golden signals, outside health checks, certificate days left. Live, but behind a login on purpose."
            width={1280}
            height={720}
          />
          <div class="b-stats card" data-spot>
            <p class="stats-title mono">by the numbers</p>
            <dl class="stats">
              {
                numbers.map((n) => (
                  <div class="stat">
                    <dt>{n.label}</dt>
                    <dd data-count={n.value} data-suffix={n.suffix}>
                      {n.value}
                      {n.suffix}
                    </dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- PIPELINE -->
    <section class="section" id="pipeline" aria-labelledby="pipeline-title">
      <div class="wrap">
        <p class="eyebrow">How it ships</p>
        <h2 id="pipeline-title" class="section-title">From <code class="title-code">git push</code> to my phone.</h2>
        <p class="section-intro">Seven stages, no hand steps. This is the path every change to BattleRoom takes.</p>

        <Pipeline />

        <div class="highlights">
          <article class="hl card" data-spot>
            <p class="hl-kicker mono">tests</p>
            <h3>Proof the tests work</h3>
            <p>I removed the crash fix on purpose: all 8 safety tests failed. Put it back: all pass.</p>
          </article>
          <article class="hl card" data-spot>
            <p class="hl-kicker mono">rollback</p>
            <h3>Rollback is one field</h3>
            <p>Type an old SHA into “Run workflow”. Tests and build are skipped and the old image goes straight out.</p>
          </article>
          <article class="hl card" data-spot>
            <p class="hl-kicker mono">monitoring</p>
            <h3>Who watches the watcher?</h3>
            <p>
              A GitHub workflow checks the game and the monitoring stack every 15 minutes from outside AWS, and posts to
              Discord only when something breaks or recovers.
            </p>
          </article>
        </div>

        <div class="rules-row">
          <p class="mono dim">alert rules →</p>
          <ul class="rules" role="list">{alertRules.map((r) => <li>{r}</li>)}</ul>
        </div>
      </div>
    </section>

    <!-- STACK -->
    <section class="section" id="stack" aria-labelledby="stack-title">
      <div class="wrap stack-grid">
        <div>
          <p class="eyebrow">Under the hood</p>
          <h2 id="stack-title" class="section-title">What it runs on.</h2>
          <p class="section-intro">
            Two EC2 servers in a custom VPC, all in Terraform. Ansible takes a blank server to a running app: rebuild
            it, run the playbook, and it comes back with a fresh certificate.
          </p>
          <p class="stack-cta">
            <a class="btn btn-primary" href="/battleroom/">Architecture, tests &amp; decisions <span aria-hidden="true">→</span></a>
          </p>
        </div>
        <figure class="yaml card" data-spot>
          <figcaption class="yaml-bar mono"><span>stack.yml</span><span class="dim">yaml</span></figcaption>
          <pre><code set:html={yamlHtml} /></pre>
        </figure>
      </div>
    </section>

    <!-- EXPERIENCE + EDUCATION -->
    <section class="section" id="experience" aria-labelledby="exp-title">
      <div class="wrap">
        <p class="eyebrow">Experience</p>
        <h2 id="exp-title" class="section-title">Where I work.</h2>
        <div class="exp-grid">
          <article class="job card" data-spot>
            <header class="job-head">
              <div>
                <h3>Telgoo5</h3>
                <p class="job-role">Technical Project Coordinator (Trainee)</p>
                <p class="dim">Telecom BSS/MVNE SaaS · Noida</p>
              </div>
              <span class="tag"><span class="dot" aria-hidden="true"></span>Mar 2026 → now</span>
            </header>
            <ul class="bullets" role="list">{jobBullets.map((b) => <li>{b}</li>)}</ul>
          </article>

          <div class="side">
            <article class="edu card" data-spot>
              <p class="hl-kicker mono">education</p>
              <h3>B.Tech, Computer Science &amp; Engineering</h3>
              <p class="dim">ABES Engineering College (AKTU), Ghaziabad · 2022–2026 · CGPA 7.62/10</p>
              <ul class="bullets small" role="list">
                <li>250+ DSA problems solved (LeetCode, GeeksforGeeks, CodeChef)</li>
                <li>HackerRank: 4-star Problem Solving; SQL (Basic &amp; Intermediate) certified</li>
              </ul>
            </article>
            <article class="edu card" data-spot>
              <p class="hl-kicker mono">also built</p>
              <ul class="also" role="list">
                <li>
                  <a class="ext" href="https://github.com/Utkarsh-262003/think-box-project-master" rel="noopener">Realtime Chat App</a>
                  <span class="dim">MERN · Socket.IO · JWT</span>
                </li>
                <li>
                  <a class="ext" href="https://github.com/Utkarsh-262003/product-management-system-main" rel="noopener">Product Management System</a>
                  <span class="dim">MERN · REST APIs · JWT</span>
                </li>
              </ul>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- SKILLS -->
    <section class="section" id="skills" aria-labelledby="skills-title">
      <div class="wrap">
        <p class="eyebrow">Toolbox</p>
        <h2 id="skills-title" class="section-title">Skills.</h2>
        <dl class="skills">
          {
            skills.map((s) => (
              <div class:list={["skill-row", { learning: s.group === "Learning now" }]}>
                <dt class="mono">{s.group}</dt>
                <dd>
                  <ul class="chips" role="list">
                    {s.items.map((i) => <li>{i}</li>)}
                  </ul>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="section contact" id="contact" aria-labelledby="contact-title">
      <div class="wrap">
        <p class="eyebrow">Contact</p>
        <h2 id="contact-title" class="contact-title">Let’s build something<br />that stays up.</h2>
        <p class="contact-mail">
          <a id="email" href={`mailto:${person.email}`}>{person.email}</a>
          <button class="btn" type="button" data-copy={person.email} data-copy-target="#email" hidden>Copy</button>
        </p>
        <ul class="contact-links" role="list">
          <li><a class="btn ext" href={person.linkedin} rel="noopener">LinkedIn</a></li>
          <li><a class="btn ext" href={person.github} rel="noopener">GitHub</a></li>
          {resume && <li><a class="btn" href={resume}>Resume <span class="mono dim">PDF</span></a></li>}
        </ul>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    gap: var(--space-7);
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
    align-items: center;
  }
  @media (min-width: 1000px) {
    .hero {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: var(--space-8);
      padding-top: var(--space-9);
      padding-bottom: var(--space-9);
      min-height: calc(100svh - 57px);
      align-items: start;
    }
    .hero :global(.term) { margin-top: var(--space-8); }
  }

  .hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 12px;
    border: 1px solid rgba(200, 246, 91, 0.3);
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
  }

  h1 {
    font-size: var(--text-hero);
    line-height: 0.88;
    letter-spacing: -0.045em;
    font-weight: 800;
    margin-top: var(--space-5);
  }
  .period { color: var(--accent); }

  .tagline {
    margin-top: var(--space-5);
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.375rem);
    line-height: 1.45;
    max-width: 34ch;
    color: var(--text);
  }

  .where {
    margin-top: var(--space-4);
    color: var(--muted);
    font-size: var(--text-sm);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
  }
  .clock {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
    align-self: center;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }

  .dim { color: var(--muted); }

  /* ---------- Marquee ---------- */
  .marquee {
    border-block: 1px solid var(--line);
    background: var(--bg-2);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 45s linear infinite;
  }
  .marquee:hover .marquee-track { animation-play-state: paused; }
  .marquee-list {
    display: flex;
    flex: none;
  }
  .marquee-list li {
    padding: var(--space-4) var(--space-5);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--muted);
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: var(--space-5);
    transition: color 140ms ease-out;
  }
  .marquee-list li::after {
    content: "✦";
    font-size: 0.6em;
    color: var(--accent);
    opacity: 0.7;
  }
  .marquee-list li:hover { color: var(--text); }
  @keyframes marquee {
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; width: auto; flex-wrap: wrap; justify-content: center; }
    .marquee-list:last-child { display: none; }
    .marquee-list { flex-wrap: wrap; justify-content: center; }
    .marquee { -webkit-mask-image: none; mask-image: none; }
  }

  /* ---------- Bento ---------- */
  .kbd-inline {
    display: inline-grid;
    place-items: center;
    width: 1.6em;
    height: 1.6em;
    border: 1px solid var(--line-2);
    border-radius: 6px;
    font-size: 0.8em;
    vertical-align: 0.1em;
  }

  .bento {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-7);
  }
  @media (min-width: 1000px) {
    .bento {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-auto-flow: dense;
    }
    .bento :global(.b-game) { grid-column: 1 / 9; grid-row: 1; }
    .bento :global(.b-discord) { grid-column: 9 / 13; grid-row: 1 / 3; }
    .bento :global(.b-pipe) { grid-column: 1 / 9; grid-row: 2; }
    .bento :global(.b-grafana) { grid-column: 1 / 8; grid-row: 3; }
    .b-stats { grid-column: 8 / 13; grid-row: 3; }
  }
  @media (max-width: 999px) {
    .bento :global(.b-discord) { max-width: 420px; }
    .bento :global(.b-discord .clip-frame) { aspect-ratio: 540 / 1020; }
  }

  .b-stats {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
  }
  .stats-title {
    font-size: var(--text-xs);
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .stats {
    margin-top: var(--space-3);
    display: grid;
    flex: 1;
  }
  .stat {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
  }
  .stat:last-child { border-bottom: 0; }
  .stat dd {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 1.2rem + 1.4vw, 2.5rem);
    line-height: 1;
    min-width: 3.4ch;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
  }
  .stat dt { color: var(--muted); font-size: var(--text-sm); }

  /* ---------- Pipeline extras ---------- */
  .title-code {
    font-family: var(--font-mono);
    font-size: 0.8em;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--accent);
    padding: 0 0.15em;
    border-radius: 8px;
    background: var(--accent-soft);
  }

  .highlights {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }
  @media (min-width: 800px) {
    .highlights { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .hl { padding: var(--space-5); }
  .hl-kicker {
    font-size: var(--text-xs);
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .hl h3 { font-size: var(--text-lg); margin-top: var(--space-2); }
  .hl p:last-child { color: var(--muted); margin-top: var(--space-2); font-size: var(--text-sm); }

  .rules-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-5);
  }
  .rules-row .rules { margin-top: 0; }
  .rules-row > p { font-size: var(--text-xs); }

  /* ---------- Stack ---------- */
  .stack-grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  @media (min-width: 1000px) {
    .stack-grid { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); }
  }
  .stack-cta { margin-top: var(--space-6); }
  .stack-cta .btn { white-space: normal; }

  .yaml { background: rgba(13, 16, 21, 0.92); }
  .yaml-bar {
    display: flex;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--line);
    font-size: var(--text-xs);
    color: var(--text);
  }
  .yaml pre {
    padding: var(--space-4) var(--space-5);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.75;
    scrollbar-width: thin;
    scrollbar-color: var(--line-2) transparent;
  }
  .yaml code { font-size: inherit; }
  .yaml :global(.yk) { color: #9ecbff; }
  .yaml :global(.yp) { color: var(--muted); }
  .yaml :global(.yv) { color: var(--text); }
  .yaml :global(.yn) { color: var(--warn); }
  .yaml :global(.yc) { color: var(--faint); }

  /* ---------- Experience ---------- */
  .exp-grid {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-7);
  }
  @media (min-width: 1000px) {
    .exp-grid { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); }
  }
  .job, .edu { padding: var(--space-5); }
  @media (min-width: 720px) {
    .job { padding: var(--space-6); }
  }
  .job-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .job h3 { font-size: var(--text-xl); line-height: 1; }
  .job-role { font-weight: 600; margin-top: var(--space-2); }
  .job-head .dim { font-size: var(--text-sm); }

  .bullets { margin-top: var(--space-5); display: grid; gap: var(--space-3); }
  .bullets li {
    position: relative;
    padding-left: var(--space-5);
    color: var(--text);
  }
  .bullets li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 8px;
    height: 2px;
    background: var(--accent);
  }
  .bullets.small { margin-top: var(--space-4); font-size: var(--text-sm); }

  .side { display: grid; gap: var(--space-4); align-content: start; }
  .edu h3 { font-size: var(--text-lg); margin-top: var(--space-2); line-height: 1.2; }
  .edu > .dim { font-size: var(--text-sm); margin-top: var(--space-2); }
